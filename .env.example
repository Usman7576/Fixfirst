# Copy to .env for running the API/worker outside Docker. Compose sets these itself.
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://triage:triage@localhost:5432/triage
WEB_ORIGIN=http://localhost:5173

# Integration tests run against this database (it is migrated up and down, so don't point it at real data).
TEST_DATABASE_URL=postgresql+asyncpg://triage:triage@localhost:5432/triage_test

# GitHub OAuth App (README → "GitHub sign-in"). Compose also reads these two from .env.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:8000

# Required in staging/production only; local and CI use fixed development keys.
# JWT_SIGNING_KEY=            (32+ random characters)
# TOKEN_ENCRYPTION_KEY=       (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")

# Added in later weeks (see docs/Fixfirst-Planning-Document.pdf, section 20.4):
# GROQ_API_KEY, GEMINI_API_KEY, MODELS_CONFIG
