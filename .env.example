# Copy to .env for running the API/worker outside Docker. Compose sets these itself.
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://triage:triage@localhost:5432/triage
WEB_ORIGIN=http://localhost:5173

# Integration tests run against this database (it is migrated up and down, so don't point it at real data).
TEST_DATABASE_URL=postgresql+asyncpg://triage:triage@localhost:5432/triage_test

